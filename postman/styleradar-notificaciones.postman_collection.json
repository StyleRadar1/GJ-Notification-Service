    {
      "name": "Pruebas Dependientes ms-item-catalogo",
      "item": [
        {
          "name": "1. Crear Alerta de Item Agotado",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Talla unica por ejecucion: dos ejecuciones al mismo tiempo (push y pull request) no chocan en QA.",
                  "pm.collectionVariables.set('tallaRun', 'Q' + Date.now().toString(36));",
                  "// Deja el escenario limpio: desactiva alertas ACTIVAS previas de la misma prenda y talla,",
                  "// para que la coleccion se pueda ejecutar varias veces contra una base persistente (QA) sin 409.",
                  "const base = pm.variables.get('baseUrl');",
                  "const cab = { Authorization: 'Bearer ' + pm.variables.get('jwtToken') };",
                  "pm.sendRequest({ url: base + '/api/v1/users/me/alerts', method: 'GET', header: cab }, function (err, res) {",
                  "  if (err || res.code !== 200) { return; }",
                  "  res.json()",
                  "    .filter(function (a) { return a.estado === 'ACTIVA' && String(a.itemId) === '1045' && a.tallaObjetivo === 'M'; })",
                  "    .forEach(function (a) {",
                  "      pm.sendRequest({ url: base + '/api/v1/users/me/alerts/' + a.id, method: 'DELETE', header: cab }, function () {});",
                  "    });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Alerta creada con estado ACTIVA', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body.estado).to.eql('ACTIVA');",
                  "    pm.expect(body.tipoAlerta).to.eql('ITEM_AGOTADO');",
                  "    pm.collectionVariables.set('alertaId', String(body.id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoAlerta\": \"ITEM_AGOTADO\",\n  \"itemId\": 1045,\n  \"tallaObjetivo\": \"{{tallaRun}}\",\n  \"canal\": \"IN_APP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "alerts"
              ]
            }
          }
        },
        {
          "name": "2. Listar Mis Alertas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna listado de alertas del usuario', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array');",
                  "    pm.expect(body.length).to.be.above(0);",
                  "});",
                  "pm.test('La alerta creada en el paso anterior aparece en la lista', function () {",
                  "    const body = pm.response.json();",
                  "    const creada = body.find(function (a) { return String(a.id) === pm.collectionVariables.get('alertaId'); });",
                  "    pm.expect(creada, 'alerta creada en el paso 1').to.not.be.undefined;",
                  "    pm.expect(creada.estado).to.eql('ACTIVA');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "alerts"
              ]
            }
          }
        },
