20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="«extend»&lt;br&gt;[si existen coincidencias]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#47119A;strokeWidth=1.5;fontColor=#262626;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;strokeColor=#47119A;strokeWidth=1.5;edgeStyle=none;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=12;fontFamily=Poppins;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPoppins;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="Línea continua: el actor participa en el caso de uso. Flecha con triángulo hueco: el rol hereda del actor «Usuario autenticado». Flecha discontinua «extend»: SR-RF-31 extiende a SR-RF-30 solo si existen coincidencias. SR-RF-30 y SR-RF-106 los dispara la actividad de otros módulos. SR-RNF-15 es no funcional y no es un caso de uso." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF8E8;strokeColor=#8E8CA0;fontColor=#262626;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Poppins;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPoppins;" vertex="1" parent="1"><mxGeometry x="1560" y="140" width="480" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>