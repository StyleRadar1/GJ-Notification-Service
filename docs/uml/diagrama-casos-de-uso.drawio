<mxfile host="app.diagrams.net"><diagram id="d1" name="Diagram"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1640" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c4" value="Diagrama de casos de uso · ms-notificaciones" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#47119A;strokeColor=none;fillColor=none;fontFamily=Poppins;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPoppins;" vertex="1" parent="1"><mxGeometry x="70" y="28" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Notificaciones y alertas · Guatoque Jiraguas" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;fontFamily=Poppins;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPoppins;" vertex="1" parent="1"><mxGeometry x="70" y="80" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c6" value="ms-notificaciones" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#47119A;strokeWidth=3;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#47119A;spacingTop=10;fontFamily=Poppins;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPoppins;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="760" height="1440" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;SR-RF-29&lt;/b&gt;&lt;br&gt;Configurar alerta de disponibilidad" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E4DBF0;strokeColor=#47119A;strokeWidth=2;fontColor=#47119A;fontSize=17;fontFamily=Poppins;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPoppins;" vertex="1" parent="1"><mxGeometry x="780" y="220" width="600" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;SR-RF-30&lt;/b&gt;&lt;br&gt;Det