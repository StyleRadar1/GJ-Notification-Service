# HTTP Server Configuration
PORT=8300
SPRING_PROFILES_ACTIVE=dev

# Relational Database PostgreSQL (Database-per-Service)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notificaciones_db
DB_USER=styleradar_user
DB_PASSWORD=styleradar_secret

# Event Broker RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=styleradar.exchange
RABBITMQ_DLX=styleradar.dlx

# Redis Cache & Deduplication
REDIS_HOST=localhost
REDIS_PORT=6379

# External Microservices (Feign Client)
CATALOG_SERVICE_URL=http://localhost:8220

# Security & JWT
# Valor solo para desarrollo local; define un secreto propio en QA y PROD
JWT_SECRET=solo_desarrollo_local_no_usar_en_produccion_styleradar_2026
JWT_EXPIRATION_MS=86400000
